{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": "*.md",
      "options": { "proseWrap": "preserve", "printWidth": 120, "tabWidth": 2 }
    },
    { "files": "*.{yml,yaml}", "options": { "tabWidth": 2 } },
    { "files": "package.json", "options": { "tabWidth": 2 } },
    { "files": "*.{js,ts,jsx,tsx}", "options": { "tabWidth": 2 } },
    { "files": "*.{css,scss,sass}", "options": { "tabWidth": 2 } },
    { "files": "*.{html,htm}", "options": { "tabWidth": 2 } }
  ]
}
