{
  "name": "@ai-agent-manager/github-dispatcher-action",
  "version": "1.1.0",
  "description": "GitHub Action that dispatches AI agent skills against pull request events.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run build && npm run lint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-agent-manager/github-dispatcher-action"
  },
  "license": "Apache-2.0"
}
